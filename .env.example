# ============================================================================
# QuickOrder Environment Variables - Complete Configuration
# ============================================================================
# Copy this file to .env for local development
# For Railway deployment, add variables in the Railway dashboard
# IMPORTANT: Never commit .env or .env.production to git

# ============================================================================
# REQUIRED VARIABLES (Must be set for production)
# ============================================================================

# MongoDB Connection String (REQUIRED)
# Production: MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Get from MongoDB Atlas > Clusters > Connect > Connect your application
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/quickorder?retryWrites=true&w=majority

# JWT Secret Key (REQUIRED)
# Must be at least 32 characters long
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Change for each environment and rotate periodically
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this

# Node Environment (REQUIRED)
# development | test | production
NODE_ENV=development

# ============================================================================
# SERVER CONFIGURATION (OPTIONAL - defaults provided)
# ============================================================================

# Server Port
# Default: 5001
# Railway automatically assigns via environment
PORT=5001

# JWT Expiration
# Default: 24h
JWT_EXPIRES_IN=24h

# ============================================================================
# EMAIL SERVICE (OPTIONAL - required only if email features needed)
# ============================================================================

# SendGrid Email Service
# API key from: https://sendgrid.com/ > Settings > API Keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Sender email address (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=noreply@quickorder.com

# Email service name
EMAIL_SERVICE=sendgrid

# Sender display name
EMAIL_FROM_NAME=QuickOrder Team

# ============================================================================
# RATE LIMITING (OPTIONAL - uses defaults if not set)
# ============================================================================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Rate limit maximum requests per window (default: 100)
RATE_LIMIT_MAX=100

# ============================================================================
# LOGGING & DEBUGGING (OPTIONAL)
# ============================================================================

# Log level: error | warn | info | debug | trace
LOG_LEVEL=info

# ============================================================================
# CORS CONFIGURATION (OPTIONAL)
# ============================================================================

# CORS Origin - allowed frontend domain
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# DATABASE BACKUP & MAINTENANCE (FOR MONGODB ATLAS)
# ============================================================================

# Optional: Separate test database
# If not set, uses MONGO_URI above
TEST_MONGO_URI=mongodb+srv://test:password@cluster.mongodb.net/quickorder-test?retryWrites=true&w=majority

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================

# For Railway (Recommended):
# 1. Create account at https://railway.app
# 2. Connect GitHub repository
# 3. Add environment variables in Railway dashboard:
#    MONGO_URI, JWT_SECRET, NODE_ENV, SENDGRID_API_KEY (optional)
# 4. Railway automatically builds and deploys on git push

# For Local Development:
# 1. Copy this file to .env
# 2. Fill in MONGO_URI and JWT_SECRET
# 3. npm install
# 4. npm start (runs on port 5001)
# 5. npm test (runs test suite)
