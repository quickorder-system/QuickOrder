{
  "info": {
    "name": "QuickOrder Phase 1-4 Testing",
    "description": "Complete API collection for testing Phases 1-4",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "password123",
      "type": "string"
    },
    {
      "key": "addressId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Phase 1 - Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Phase 2 - Menu & Inventory",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "categories"]
            }
          }
        },
        {
          "name": "Get Items by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/items?category=appetizers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "items"],
              "query": [
                {
                  "key": "category",
                  "value": "appetizers"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Phase 4 - Authentication",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('userId', pm.response.json().user.id);",
                  "  pm.environment.set('testEmail', pm.request.body.raw);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/customer/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customer", "register"]
            }
          }
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('authToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/customer/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customer", "login"]
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"[verification_token_from_email]\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/customer/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customer", "verify-email"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/customer/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customer", "forgot-password"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/customer/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customer", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/customer/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customer", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Phase 4 - Profile Management",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"+1234567890\",\n  \"preferences\": {\n    \"notifications\": true,\n    \"marketingEmails\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "profile"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{testPassword}}\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Phase 4 - Address Management",
      "item": [
        {
          "name": "Get All Addresses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "addresses"]
            }
          }
        },
        {
          "name": "Add Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('addressId', pm.response.json().address._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"home\",\n  \"street\": \"123 Main St\",\n  \"city\": \"Manila\",\n  \"postalCode\": \"1234\",\n  \"phone\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "addresses"]
            }
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"street\": \"456 New St\",\n  \"city\": \"Quezon City\",\n  \"postalCode\": \"5678\",\n  \"phone\": \"+0987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "addresses", "{{addressId}}"]
            }
          }
        },
        {
          "name": "Set Default Address",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/addresses/{{addressId}}/default",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "addresses", "{{addressId}}", "default"]
            }
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "addresses", "{{addressId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Phase 4 - Order Management",
      "item": [
        {
          "name": "Get Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/orders?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "orders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "completed",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Order Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "orders", "{{orderId}}"]
            }
          }
        }
      ]
    }
  ]
}
