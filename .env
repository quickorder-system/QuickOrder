# NEVER commit this file to git. Use .env.example as template.
# This file is for LOCAL DEVELOPMENT ONLY

# Database - Use local MongoDB or Atlas connection string
MONGO_URI=mongodb://localhost:27017/quickOrderDB

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration - Use a strong random secret
JWT_SECRET=your-strong-random-secret-key-minimum-32-characters
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email Configuration (SendGrid)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=QuickOrder <noreply@quickorder.com>
EMAIL_FROM_NAME=QuickOrder Team